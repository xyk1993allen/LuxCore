diff --git a/build-system/wheels/build_oidn_cuda_windows.sh b/build-system/wheels/build_oidn_cuda_windows.sh
new file mode 100644
index 0000000..151a5e0
--- /dev/null
+++ b/build-system/wheels/build_oidn_cuda_windows.sh
@@ -0,0 +1,74 @@
+#!/bin/bash
+# SPDX-FileCopyrightText: 2026 Authors (see AUTHORS.txt)
+#
+# SPDX-License-Identifier: Apache-2.0
+#
+# Build the CUDA device module of Open Image Denoise (GPU denoising) with the
+# same version, namespace and library name as the OIDN provided by LuxCoreDeps,
+# and drop it next to the OIDN core library so that it is bundled in the wheel.
+# Requires the CUDA toolkit (CUDA_PATH) and MSVC in the environment.
+# The build is optional: on failure, the wheel is built without GPU denoising.
+
+set -o pipefail
+
+OIDN_VERSION=2.5.0
+workspace=$(cygpath -u "${1:-$GITHUB_WORKSPACE}")
+deps="$workspace/out/dependencies/full_deploy/host"
+oidn_bin="$deps/oidn/$OIDN_VERSION/Release/x86_64/bin"
+
+if [[ -z "${CUDA_PATH}" ]]; then
+  echo "[OIDN CUDA] CUDA_PATH not set, skipping GPU denoiser build"
+  exit 0
+fi
+if [[ ! -d "$oidn_bin" ]]; then
+  echo "[OIDN CUDA] OIDN not found in dependencies ($oidn_bin), skipping"
+  exit 0
+fi
+
+tbb_dir=$(find "$deps/onetbb" -type d -path "*/lib/cmake/TBB" | head -1)
+echo "[OIDN CUDA] CUDA_PATH=${CUDA_PATH}"
+echo "[OIDN CUDA] TBB_DIR=${tbb_dir}"
+
+build_root="$workspace/oidn-cuda"
+rm -rf "$build_root" && mkdir -p "$build_root"
+cd "$build_root" || exit 0
+
+pip install ninja
+
+git lfs install
+if ! git clone --recursive --depth 1 --branch "v${OIDN_VERSION}" \
+    https://github.com/RenderKit/oidn.git src; then
+  echo "[OIDN CUDA] clone failed, skipping"
+  exit 0
+fi
+
+if ! cmake -S src -B build -G Ninja \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_CUDA_FLAGS="-allow-unsupported-compiler" \
+    -DOIDN_DEVICE_CPU=OFF \
+    -DOIDN_DEVICE_CUDA=ON \
+    -DOIDN_DEVICE_CUDA_API=Driver \
+    -DOIDN_API_NAMESPACE=lux \
+    -DOIDN_LIBRARY_NAME=LuxOpenImageDenoise \
+    -DOIDN_APPS=OFF \
+    -DOIDN_FILTER_RT=ON \
+    -DOIDN_FILTER_RTLIGHTMAP=ON \
+    -DTBB_DIR="$(cygpath -m "$tbb_dir")"; then
+  echo "[OIDN CUDA] configure failed, skipping"
+  exit 0
+fi
+
+if ! cmake --build build --target LuxOpenImageDenoise_device_cuda; then
+  echo "[OIDN CUDA] build failed, skipping"
+  exit 0
+fi
+
+module=$(find build -name "LuxOpenImageDenoise_device_cuda.dll" | head -1)
+if [[ -z "$module" ]]; then
+  echo "[OIDN CUDA] module not found after build, skipping"
+  exit 0
+fi
+
+cp "$module" "$oidn_bin/"
+echo "[OIDN CUDA] installed $(basename "$module") into $oidn_bin"
+ls -la "$oidn_bin"
