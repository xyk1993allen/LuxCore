+// Builds the OIDN plugin used by Film::ApplyOIDN() from its settings
+static slg::IntelOIDN MakeApplyOIDNPlugin(const luxrays::Properties &p) {
+	using luxrays::Property;
+	return slg::IntelOIDN("RT",
+			p.Get(Property("oidnmemory")(6000)).Get<int>(), 0.f, true, 0.f,
+			p.Get(Property("quality")("DEFAULT")).Get<string>(),
+			p.Get(Property("passes")("ALBEDO_NORMAL")).Get<string>(),
+			p.Get(Property("prefilter.mode")("ACCURATE")).Get<string>(),
+			p.Get(Property("usegpu")(false)).Get<bool>());
+}
+
+void FilmImplSession::ApplyOIDN(const u_int index, const luxrays::Properties &oidnProps) {
+	API_BEGIN("{}", index);
+	slg::IntelOIDN oidn = MakeApplyOIDNPlugin(oidnProps);
+
+	std::unique_lock<std::mutex> lock(renderSession.GetSLGRenderSession().filmMutex);
+	oidn.Apply(*renderSession.GetSLGRenderSession().film, index);
+
+	API_END();
+}
