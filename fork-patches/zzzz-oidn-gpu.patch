+//------------------------------------------------------------------------------
+// OIDN devices are expensive to create (a GPU device takes about a second), so
+// they are created once and reused. GPU devices run one filter at a time.
+//------------------------------------------------------------------------------
+
+namespace {
+
+std::mutex oidnDeviceMutex;
+lux::oidn::DeviceRef oidnCPUDevice, oidnGPUDevice;
+bool oidnGPUDeviceFailed = false;
+// Serializes the filters executed on the GPU device
+std::mutex oidnGPUExecMutex;
+
+lux::oidn::DeviceRef CreateOIDNDevice(const lux::oidn::DeviceType type) {
+	lux::oidn::DeviceRef device = lux::oidn::newDevice(type);
+
+	const char *errorMessage;
+	if (!device || (device.getError(errorMessage) != lux::oidn::Error::None))
+		return lux::oidn::DeviceRef();
+
+	device.set("verbose", 0);
+	if (type == lux::oidn::DeviceType::CPU)
+		device.set("setAffinity", false);
+	device.commit();
+
+	if (device.getError(errorMessage) != lux::oidn::Error::None)
+		return lux::oidn::DeviceRef();
+
+	device.setErrorFunction(errorCallback);
+	return device;
+}
+
+// Returns the device to use and if it is a GPU device
+lux::oidn::DeviceRef GetOIDNDevice(const bool useGPU, bool &isGPU) {
+	std::lock_guard<std::mutex> lock(oidnDeviceMutex);
+
+	if (useGPU && !oidnGPUDeviceFailed) {
+		if (!oidnGPUDevice) {
+			// Look for a GPU device (CUDA, HIP, SYCL or Metal)
+			const int count = lux::oidn::getNumPhysicalDevices();
+			for (int i = 0; i < count; ++i) {
+				const lux::oidn::PhysicalDeviceRef pd(i);
+				const auto type = (lux::oidn::DeviceType)pd.get<int>("type");
+				if (type == lux::oidn::DeviceType::CPU)
+					continue;
+
+				oidnGPUDevice = CreateOIDNDevice(type);
+				if (oidnGPUDevice) {
+					SLG_LOG("IntelOIDNPlugin using GPU device: " << pd.get<std::string>("name"));
+					break;
+				}
+			}
+
+			if (!oidnGPUDevice) {
+				SLG_LOG("IntelOIDNPlugin no usable GPU device found, falling back to the CPU");
+				oidnGPUDeviceFailed = true;
+			}
+		}
+
+		if (oidnGPUDevice) {
+			isGPU = true;
+			return oidnGPUDevice;
+		}
+	}
+
+	if (!oidnCPUDevice) {
+		oidnCPUDevice = CreateOIDNDevice(lux::oidn::DeviceType::CPU);
+		if (!oidnCPUDevice)
+			throw std::runtime_error("IntelOIDNPlugin unable to create the CPU device");
+	}
+
+	isGPU = false;
+	return oidnCPUDevice;
+}
+
+lux::oidn::Quality ParseOIDNQuality(const string &q) {
+	if (q == "HIGH")
+		return lux::oidn::Quality::High;
+	if (q == "BALANCED")
+		return lux::oidn::Quality::Balanced;
+	if (q == "FAST")
+		return lux::oidn::Quality::Fast;
+	return lux::oidn::Quality::Default;
+}
