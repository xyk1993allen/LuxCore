+
+using namespace std;
+using namespace luxrays;
+
+namespace slg {
+
+u_int LightLinkParseReceiverSet(const Properties &props, const string &propName) {
+	const string name = propName + ".lightlink.receiverset";
+	if (!props.IsDefined(name))
+		return 0;
+
+	const u_int set = props.Get(name).Get<u_int>();
+	if (set >= LIGHTLINK_SET_COUNT)
+		throw runtime_error("Light linking receiver set out of range [0, " +
+				to_string(LIGHTLINK_SET_COUNT - 1) + "]: " + name);
+
+	return set;
+}
+
+LightLinkMask LightLinkParseReceiverMask(const Properties &props, const string &propName) {
+	const string name = propName + ".lightlink.receiversets";
+	if (!props.IsDefined(name))
+		return LIGHTLINK_MASK_ALL;
+
+	const Property &prop = props.Get(name);
+	LightLinkMask mask = 0ull;
+	for (u_int i = 0; i < prop.GetSize(); ++i) {
+		const u_int set = prop.Get<u_int>(i);
+		if (set >= LIGHTLINK_SET_COUNT)
+			throw runtime_error("Light linking receiver set out of range [0, " +
+					to_string(LIGHTLINK_SET_COUNT - 1) + "]: " + name);
+		mask |= (1ull << set);
+	}
+
+	return mask;
+}
+
+Property LightLinkReceiverMaskToProperty(const string &propName, const LightLinkMask mask) {
+	Property prop(propName + ".lightlink.receiversets");
+	for (u_int i = 0; i < LIGHTLINK_SET_COUNT; ++i) {
+		if (LightLinkMaskIncludes(mask, i))
+			prop.Add<u_int>(i);
+	}
+
+	return prop;
+}
+
+}
