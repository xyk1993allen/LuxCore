+
+#ifndef _SLG_LIGHTLINKING_H
+#define	_SLG_LIGHTLINKING_H
+
+#include <string>
+
+#include "luxrays/utils/properties.h"
+
+namespace slg {
+
+//------------------------------------------------------------------------------
+// Light linking
+//
+// Every scene object belongs to one "receiver set" (an index in
+// [0, LIGHTLINK_SET_COUNT), 0 being the default set). Every light source has a
+// mask of the receiver sets it illuminates (all sets by default). When a light
+// does not include the receiver set of a surface, its direct contribution to
+// that surface is removed, both from direct light sampling and from BSDF
+// sampling hitting the light, so MIS stays consistent.
+//
+// Scene description:
+//   scene.objects.<name>.lightlink.receiverset = <u_int>
+//   scene.lights.<name>.lightlink.receiversets = <u_int> <u_int> ...
+//   scene.objects.<name>.lightlink.receiversets = ...  (for emissive objects)
+//
+// When ".lightlink.receiversets" is not defined, the light illuminates
+// everything.
+//------------------------------------------------------------------------------
+
+typedef unsigned long long LightLinkMask;
+
+#define LIGHTLINK_SET_COUNT 64u
+#define LIGHTLINK_MASK_ALL (~0ull)
+
+inline bool LightLinkMaskIncludes(const LightLinkMask mask, const u_int set) {
+	return (mask >> set) & 1ull;
+}
+
+extern u_int LightLinkParseReceiverSet(const luxrays::Properties &props, const std::string &propName);
+extern LightLinkMask LightLinkParseReceiverMask(const luxrays::Properties &props, const std::string &propName);
+extern luxrays::Property LightLinkReceiverMaskToProperty(const std::string &propName, const LightLinkMask mask);
+
+}
+
+#endif	/* _SLG_LIGHTLINKING_H */
