@@ -36,8 +36,8 @@ namespace slg {
 // sampling hitting the light, so MIS stays consistent.
 //
 // Scene description:
-//   scene.objects.<name>.lightlink.receiverset = <u_int>
-//   scene.lights.<name>.lightlink.receiversets = <u_int> <u_int> ...
+//   scene.objects.<name>.lightlink.receiverset = <unsigned int>
+//   scene.lights.<name>.lightlink.receiversets = <unsigned int> <unsigned int> ...
 //   scene.objects.<name>.lightlink.receiversets = ...  (for emissive objects)
 //
 // When ".lightlink.receiversets" is not defined, the light illuminates
@@ -49,11 +49,11 @@ typedef unsigned long long LightLinkMask;
 #define LIGHTLINK_SET_COUNT 64u
 #define LIGHTLINK_MASK_ALL (~0ull)
 
-inline bool LightLinkMaskIncludes(const LightLinkMask mask, const u_int set) {
+inline bool LightLinkMaskIncludes(const LightLinkMask mask, const unsigned int set) {
 	return (mask >> set) & 1ull;
 }
 
