+extern unsigned int LightLinkParseReceiverSet(const luxrays::Properties &props, const std::string &propName);
 extern LightLinkMask LightLinkParseReceiverMask(const luxrays::Properties &props, const std::string &propName);
 extern luxrays::Property LightLinkReceiverMaskToProperty(const std::string &propName, const LightLinkMask mask);
 
